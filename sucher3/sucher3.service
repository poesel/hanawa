[Unit]
Description=sucher3 ambilight webcam daemon (Pi + PS Eye -> Leuchter UDP :1900)
After=network-online.target

[Service]
User=markus
WorkingDirectory=/home/markus/sucher3
# -u: unbuffered stdout, so the [main]/[UDP] notes reach the journal
ExecStart=/usr/bin/python3 -u /home/markus/sucher3/main.py --source webcam --device /dev/video0 --size 320x240
Restart=on-failure
RestartSec=5
